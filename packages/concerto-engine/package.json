{
  "name": "@accordproject/concerto-engine",
  "version": "5.0.0",
  "description": "The concerto-core Rust engine, compiled to WASM by concerto-rust's concerto-wasm. In this repository it links a concerto-rust checkout next to this one; the published package carries the built engine.",
  "homepage": "https://github.com/accordproject/concerto-rust",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "main": "index.js",
  "exports": {
    "import": "./index.mjs",
    "require": "./index.js"
  },
  "files": [
    "index.js",
    "index.mjs",
    "pkg/"
  ],
  "scripts": {
    "prepack": "node scripts/pack.js stage",
    "postpack": "node scripts/pack.js unstage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/accordproject/concerto.git",
    "directory": "packages/concerto-engine"
  },
  "license": "Apache-2.0"
}
