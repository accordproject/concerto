+/// P5-41 scratch: the direct encoding concerto-wasm now ships.
+struct MmView<'a>(&'a ModelManager);
+impl serde::Serialize for MmView<'_> {
+    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        use serde::ser::SerializeMap;
+        let mut m = s.serialize_map(Some(2))?;
+        m.serialize_entry("$class", "concerto.metamodel@1.0.0.Models")?;
+        m.serialize_entry("models", &Asts(self.0))?;
+        m.end()
+    }
+}
+struct Asts<'a>(&'a ModelManager);
+impl serde::Serialize for Asts<'_> {
+    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        s.collect_seq(self.0.model_files().map(concerto_core::ModelFile::ast))
+    }
+}
+struct View<'a>(&'a ExtractResult);
+impl serde::Serialize for View<'_> {
+    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        use serde::ser::SerializeMap;
+        let mut m = s.serialize_map(Some(3))?;
+        m.serialize_entry("modelManager", &MmView(&self.0.model_manager))?;
+        m.serialize_entry("decoratorCommandSet", &self.0.decorator_command_set)?;
+        m.serialize_entry("vocabularies", &self.0.vocabularies)?;
+        m.end()
+    }
+}
+
+pub fn direct() -> bool {
+    std::env::var("P530_ENCODE").map(|v| v == "direct").unwrap_or(false)
+}
